### Discord 推送（webhook 網址等同密碼，不要上傳）
# 盤前簡報、持股提醒、排程失敗通知
DISCORD_WEBHOOK_URL=
# 模擬帳戶專用頻道（沒填就送到 DISCORD_WEBHOOK_URL）
PAPER_BOT_WEBHOOK_URL=
# 1 = 模擬帳戶每日 16:50、09:30 成交後自動推送
PAPER_BOT_AUTO_SEND=1

### 本機模型（選用，用來寫一兩句摘要）
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_URL=http://localhost:11434

### 台股手續費（bps）：0.1425% × 券商折扣，2.8 折 ≈ 3.99。持股提醒估算賣出成本用
TX_FEE_BPS=3.99
